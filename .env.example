# All variables are optional; these are the defaults. Notification channels without their
# settings are disabled, and with none of them the service only serves the timetable API.
PORT=5000
DATABASE_URL=file:./data/fsre-sync-backend.db
EDUPAGE_URL=https://fsre.edupage.org
SYNC_CRON="*/15 * * * *"
LOG_LEVEL=info
# Subscriptions without a notification or resubscription for this long are deleted.
SUBSCRIPTION_TTL_DAYS=365
MAX_SUBSCRIPTIONS=10000

# Push: Firebase service account JSON (set by docker-compose.yml).
GOOGLE_APPLICATION_CREDENTIALS=./service_account_key.json

# Email: needs MAIL_USERNAME, MAIL_PASSWORD and PUBLIC_URL (for unsubscribe links).
# For Gmail, MAIL_PASSWORD is an app password.
PUBLIC_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Defaults to "FSRE Notifier <MAIL_USERNAME>".
MAIL_FROM=
